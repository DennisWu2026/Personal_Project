; =============================================================================
; ============================== Bit Fields ===================================
; =============================================================================
; ===                                                                       === 
; ===    Version      =    0x1010                                           ===
; ===       ^                 ^                                             ===
; ===       |                 |                                             ===
; ===   SETTING NAME          |                                             ===
; ===                         |                                             ===
; ===                    SETTING VALUE                                      ===
; ===                binary: b1010 = int 10                                 ===
; ===                int:     1010 = int 1010                               ===
; ===                hex:   0x1010 = int 4112                               ===
; ===                                                                       === 
; =============================================================================

;Option bits
[*General]

VRECT_OVP1_THD          = b0   ;0  :****
                               ;1  :13v
VRECT_OVP2_THD          = b0   ;0  :****
                               ;1  :15.5v
LDO_OCP_THD             = b00  ;00 :****
                               ;01 :****
                               ;10 :****
							   ;11 :****
NA2                     = b0000

MOT_SET                 = b00  ;00 :50ns
                               ;01 :150ns
                               ;10 :300ns
							   ;11 :200ns
min_off_SET             = b00  ;00 :50ns
                               ;01 :100ns
                               ;10 :340ns
							   ;11 :340ns
NA1                     = b0000

TRIM_EN_LOW_I			= b0   ;0  :****
							   ;1  :****
TRIM_DIS_CLPH_ADAP  	= b0
TRIM_EN_MOT_MULTI       = b0
TRIM_ACLOW_EN		    = b0
TRIM_SS_01_PKT_DIS      = b0
OTP_DIS_RES_SET		    = b0
TRIM_IIC_ADDR	        = b00
TRIM_DIS_OTP   	        = b0
tran_boost     	        = b00
TRIM_VRECT_DMY_DIS     	= b0
tran_boost_ibm   	    = b0
VOUT_DMY_EN        	    = b0
TRIM_DIG_IOUT_OFFSET   	= b00000
AC_CHECK_500K     	    = b1 ;dif
TTP_FSK_DIS       	    = b0
EN_OV_SHORT_LS     	    = b0
TRIM_QI_ID       	    = b00
TRIM_DEIVICE_ID     	= b101 ;1685
TRIM_LOCK     	        = b0
Reserved			    = b00000000
Reserved1   		    = b00
 
;IIC_COMM_RDSON_OPT      = b0   ;0  :comm2
;                               ;1  :comm1
;MTP_VOUT_SET			= b0111110
;I2C_PSEU_R  			= b0000;0001:4mA
;							   ;0010:8mA
;							   ;0100:16mA
;							   ;1000:32mA
[*Customer_Register]


; =============================================================================
; ==============================  Build Words  ================================
; =============================================================================
; ===                                                                       === 
; ===   0:             bandgap       =         !                  1         ===
; ===   ^                ^                     ^                  ^         ===
; ===   |                |                     |                  |         ===                            
; === BIT POS in REG     |                     |                  |         ===
; ===                    |                     |                  |         ===
; ===          PARAMETER or SETTING NAME       |                  |         ===
; ===                                          |                  |         === 
; ===                        INVERT BIT (if '!' is present)       |         ===
; ===                                                                       ===
; ===                                     BIT POS in PARAMETER or SETTING   ===
; ===                                                                       ===
; =============================================================================


[_EEPROM0]
0:  TRIM_LS2_COMP		    = 0
1:  TRIM_LS2_COMP	    	= 1
2:  TRIM_LS2_COMP	    	= 2
3:  TRIM_LS2_COMP 			= 3
4:  TRIM_LS1_COMP			= 0
5:  TRIM_LS1_COMP			= 1
6:  TRIM_LS1_COMP           = 2
7:  TRIM_LS1_COMP           = 3

[_EEPROM1]
0:  TRIM_DIS_CLPH_ADAP		= 0
1:  Reserved    		    = 0
2:  TRIM_BG				    = 0
3:  TRIM_BG					= 1
4:  TRIM_BG					= 2
5:  TRIM_BG					= 3 
6:  TRIM_BG                 = 4
7:  TRIM_BG                 = 5

